# Reserved names only (CONTRACTS §H). No secrets in the frontend.
# mock = MSW fixtures in the browser; live = real backend
VITE_API_MODE=mock
# Base path or absolute https URL of the backend API (dev proxies /api -> http://localhost:8000)
VITE_API_BASE=/api
# Demo replay clock (CONTRACTS §B). Forwarded as `now=` on every GET.
VITE_DEMO_NOW=2026-11-14T23:30:00-05:00
# Run My Night (US-08) — stretch feature flag
VITE_FEATURE_ROUTING=1
# Heat layer on the map
VITE_FEATURE_HEATMAP=1
