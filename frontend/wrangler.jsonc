// Cloudflare Workers static-assets deploy for the Nightlife Autopilot frontend.
// Build first (mock mode = in-browser synthetic API, no backend needed):
//   VITE_API_MODE=mock VITE_DEMO_NOW=2026-11-14T23:30:00-05:00 \
//   VITE_FEATURE_ROUTING=1 VITE_FEATURE_HEATMAP=1 npm run build
// then: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nightlife-autopilot",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
