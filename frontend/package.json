{
  "name": "nightlife-autopilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test --trace off",
    "mockups": "node scripts/mockups.mjs",
    "contract:live": "vitest run --config vitest.live.config.ts",
    "fixtures": "node scripts/build-fixtures.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.7",
    "maplibre-gl": "4.7.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "autoprefixer": "10.4.20",
    "axe-core": "4.10.2",
    "eslint": "9.17.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "msw": "2.6.8",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
