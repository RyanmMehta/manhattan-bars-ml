# Copy to backend/.env for local use (never commit .env). All read in app/config.py.
DATABASE_URL=sqlite:///./backend/app.db
LIVE_SIM_DB=data/live_sim.db
INCLUDE_SYNTHETIC=1
DEMO_NOW=2026-11-14T23:30:00-05:00
CORS_ORIGINS=http://localhost:5173,https://nightlife-autopilot.vercel.app
FEATURE_ROUTING=1
FEATURE_HEATMAP=1
PUBLIC_DB_PATH=data/manhattan_bars.db
LAUNCH_VENUES_CSV=data/launch_venues.csv
LAUNCH_VENUES_FULL_CSV=data/launch_venues_full.csv
MANUAL_ATTRIBUTES_CSV=data/venue_attributes_manual.csv
ALLOW_FIXTURE_SIM=1
DEMO_AUTH=1
ADMIN_TOKEN=change-me
RECS_MODE=auto
LOG_LEVEL=INFO
ALLOW_WRITE_NOW=0
